{
  "name": "slidev-addon-bpmn",
  "version": "1.10.0",
  "description": "Display BPMN 2.0 diagrams in Slidev presentations",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "slidev example.md --port $PORT --remote --bind 127.0.0.1 --open",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "build:pages": "slidev build example.md --base /slidev-addon-bpmn/ --out dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:deps": "depcruise components composables engines shared --config .dependency-cruiser.cjs --output-type err"
  },
  "author": "Marco Schäck (https://github.com/emaarco)",
  "license": "MIT",
  "dependencies": {
    "@bpmn-io/properties-panel": "3.47.0",
    "bpmn-js": "18.22.0",
    "bpmn-js-properties-panel": "5.61.0",
    "bpmn-js-token-simulation": "0.40.0",
    "camunda-bpmn-js-behaviors": "1.18.0",
    "camunda-bpmn-moddle": "7.0.1",
    "camunda-transaction-boundaries": "1.1.2",
    "zeebe-bpmn-moddle": "1.17.0"
  },
  "devDependencies": {
    "@slidev/cli": "52.18.0",
    "@slidev/theme-default": "0.25.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "dependency-cruiser": "18.1.0",
    "jsdom": "29.1.1",
    "playwright-chromium": "1.61.1",
    "portless": "0.15.4",
    "vitest": "4.1.10"
  },
  "keywords": [
    "slidev",
    "slidev-addon",
    "bpmn",
    "bpmn-js",
    "bpmn.io",
    "diagram",
    "workflow",
    "process"
  ],
  "files": [
    "components",
    "composables",
    "engines",
    "shared",
    "vite.config.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@slidev/cli": ">=50"
  },
  "peerDependenciesMeta": {
    "@slidev/cli": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaarco/slidev-addon-bpmn.git"
  },
  "bugs": {
    "url": "https://github.com/emaarco/slidev-addon-bpmn/issues"
  },
  "homepage": "https://github.com/emaarco/slidev-addon-bpmn#readme"
}
