{
  "name": "slidev-addon-bpmn",
  "version": "1.7.0",
  "description": "Display BPMN 2.0 diagrams in Slidev presentations",
  "type": "module",
  "scripts": {
    "dev": "portless run sh -c 'npx slidev example.md --port $PORT --remote --bind 127.0.0.1 --open'",
    "build": "slidev build example.md",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "build:pages": "slidev build example.md --base /slidev-addon-bpmn/ --out dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Marco Schäck (https://github.com/emaarco)",
  "license": "MIT",
  "dependencies": {
    "@bpmn-io/properties-panel": "3.42.0",
    "bpmn-js": "18.16.1",
    "bpmn-js-properties-panel": "5.56.0",
    "bpmn-js-token-simulation": "0.39.3",
    "camunda-bpmn-js-behaviors": "1.15.0",
    "camunda-bpmn-moddle": "7.0.1",
    "camunda-transaction-boundaries": "1.1.2",
    "zeebe-bpmn-moddle": "1.14.0"
  },
  "devDependencies": {
    "@slidev/cli": "52.15.2",
    "@slidev/theme-default": "0.25.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.10",
    "jsdom": "29.1.1",
    "playwright-chromium": "1.60.0",
    "vitest": "4.1.7"
  },
  "keywords": [
    "slidev",
    "slidev-addon",
    "bpmn",
    "bpmn-js",
    "bpmn.io",
    "diagram",
    "workflow",
    "process"
  ],
  "files": [
    "components",
    "composables",
    "engines",
    "internal",
    "vite.config.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@slidev/cli": ">=50"
  },
  "peerDependenciesMeta": {
    "@slidev/cli": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaarco/slidev-addon-bpmn.git"
  },
  "bugs": {
    "url": "https://github.com/emaarco/slidev-addon-bpmn/issues"
  },
  "homepage": "https://github.com/emaarco/slidev-addon-bpmn#readme"
}
